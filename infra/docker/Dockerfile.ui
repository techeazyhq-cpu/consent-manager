# One web app (mf-dp-portal, mf-df-app or mf-cm-admin), built for one environment and served by unprivileged nginx on
# 8080 (ADR-042). Vite bakes its settings in at build time, so each environment builds its own image:
#
#   docker build -f infra/docker/Dockerfile.ui --build-arg APP=mf-df-app \
#     --build-arg VITE_GW_BASE_URL=https://api.example.com --build-arg VITE_KC_BASE_URL=https://id.example.com \
#     --build-arg VITE_KC_REALM=cm-df --build-arg VITE_KC_CLIENT_ID=cm-df-app -t cm-df-app:0.1.0 .

FROM node:22.14.0-alpine AS build
ARG APP
ARG VITE_GW_BASE_URL
ARG VITE_KC_BASE_URL
ARG VITE_KC_REALM
ARG VITE_KC_CLIENT_ID
ARG VITE_SBX_GW_BASE_URL
ARG VITE_SBX_TOKEN_URL
ARG VITE_SBX_INBOX_URL
WORKDIR /src
# pnpm itself, pinned: corepack in some Node images carries stale signing keys
RUN npm install -g pnpm@11.20.0
COPY frontend/package.json frontend/pnpm-lock.yaml frontend/pnpm-workspace.yaml frontend/tsconfig.base.json ./
COPY frontend/packages ./packages
RUN pnpm install --frozen-lockfile && pnpm --filter "${APP}" build

FROM nginxinc/nginx-unprivileged:1.27.3-alpine
ARG APP
COPY --from=build /src/packages/${APP}/dist /usr/share/nginx/html
COPY infra/docker/nginx-ui.conf /etc/nginx/conf.d/default.conf
# The base image already runs as nginx (101); stated so scanners and readers see it
USER 101
EXPOSE 8080
