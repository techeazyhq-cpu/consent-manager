metry></mxCell><mxCell id="m21" value="11. confirmation" style="html=1;endArrow=block;fontSize=10;align=left;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="250" y="610" as="sourcePoint"/><mxPoint x="100" y="610" as="targetPoint"/></mxGeometry></mxCell><mxCell id="n22" value="Each step is idempotent and retried; a step that cannot complete moves the request to STUCK with an alert. Every reversible step comes before shredding (ADR-021)." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="40" y="680" width="900" height="50" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
