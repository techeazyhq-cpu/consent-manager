            "description": "The person is notified and decides in their portal. Counts against the monthly allowance.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"extDpRefTyp\": \"EMAIL\",\n  \"extDpRefVal\": \"asha@sandbox.example\",\n  \"prpsCode\": \"ORDER_UPDATES\",\n  \"dCatCodes\": [\n    \"EMAIL\"\n  ],\n  \"ntcTitle\": \"Order updates by email\",\n  \"ntcText\": \"We email you when your order ships. You can withdraw at any time.\"\n}",
